    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.4",
    "convex-test": "^0.0.34",
    "jose": "^5.9.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@auth/core": "0.37.4",
    "@cc/site-config": "workspace:*",
    "@convex-dev/auth": "^0.0.80",
    "convex": "^1.17.4",
    "convex-helpers": "^0.1.68",
    "zod": "^3.24.1"
  }
}