{
  "name": "creative-current-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "convex dev",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:tokens",
